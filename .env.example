# Kopiere diese Datei nach .env und trage deine eigenen Werte ein:
#   cp .env.example .env
# Die .env wird nie committet.

# ── Pflicht ────────────────────────────────────────────────────────────────
# Anthropic API-Key (https://console.anthropic.com → API Keys)
# Reicht für: Foto-Analyse, Inserat-Generierung, Kleinanzeigen-Veröffentlichung
ANTHROPIC_API_KEY=

# ── Optional: eBay ─────────────────────────────────────────────────────────
# Nur nötig für Preisrecherche und eBay-Veröffentlichung.
# Keys: https://developer.ebay.com/my/keys
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# RuName (eBay Redirect URL name) – nur für das Veröffentlichen per OAuth
EBAY_RUNAME=

# true = eBay Sandbox zum Veröffentlichen (Preisrecherche nutzt immer Production)
EBAY_SANDBOX=false

# Werden automatisch gesetzt, wenn du dich in der App mit eBay verbindest
EBAY_ACCESS_TOKEN=
EBAY_REFRESH_TOKEN=

# Geschäftsrichtlinien-IDs aus deinem eBay-Verkäuferkonto
EBAY_RETURN_POLICY_ID=
EBAY_PAYMENT_POLICY_ID=

# Artikelstandort
EBAY_LOCATION_STREET=
EBAY_LOCATION_CITY=
EBAY_LOCATION_ZIP=
